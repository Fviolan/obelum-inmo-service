# Copiar a .env y rellenar. En Easypanel van como variables de entorno del servicio.
SERPER_API_KEY=            # serper.dev; si se deja vacio se usa DuckDuckGo
RECON_PAGINAS=6            # paginas internas por lead
RECON_PAGINAS_RIVAL=4      # paginas por competidor
TIMEOUT_BUSQUEDA=20
OPENROUTER_API_KEY=      # openrouter.ai, para redactar los emails
SERVICE_TOKEN=            # cabecera X-Obelum-Token; vacio = sin autenticacion (solo desarrollo)
RAZONAMIENTO=on        # off|low|medium|high|on — on razona mejor y tarda mas
